{
  "name": "cursor-spending",
  "displayName": "Cursor Spending",
  "publisher": "drash-course",
  "repository": {
    "type": "git",
    "url": "https://github.com/drash-course/cursor-spending-extension.git"
  },
  "description": "Shows Cursor API usage (auto and API percent used) in the status bar",
  "version": "1.0.3",
  "icon": "images/spend_icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cursor Spending",
      "properties": {
        "cursorSpending.sessionToken": {
          "type": "string",
          "default": "",
          "description": "WorkosCursorSessionToken cookie value from cursor.com. Get it from DevTools > Application > Cookies when logged into cursor.com/dashboard."
        },
        "cursorSpending.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 60,
          "description": "Refresh interval in minutes"
        }
      }
    },
    "commands": [
      {
        "command": "cursorSpending.refresh",
        "title": "Cursor Spending: Refresh usage"
      },
      {
        "command": "cursorSpending.openTokenSetup",
        "title": "Cursor Spending: Configure session token"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:icon && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run build:icon && npm run compile && npx vsce package",
    "build:icon": "node scripts/build-icon.js"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
